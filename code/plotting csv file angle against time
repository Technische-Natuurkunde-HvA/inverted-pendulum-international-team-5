import pandas as pd
import matplotlib.pyplot as plt

# --- Read file ---
df = pd.read_csv("data.csv")   # make sure data.csv is in the same folder as the file of this code

# --- retrieve culumns ---
time = df["time_ms"]
angle = df["angle_deg"]

# --- Plot ---
plt.figure(figsize=(10, 5))
plt.plot(time, angle, linewidth=2)
plt.xlabel("Time (ms)")
plt.ylabel("Angle (degrees)")
plt.title("Angle vs Time")
plt.grid(True)
plt.tight_layout()
plt.show()
